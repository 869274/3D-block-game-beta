<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>3D Block Game Beta</title>
  <style>
    :root {
      --panel: rgba(0,0,0,0.25);
      --panelBorder: rgba(255,255,255,0.2);
      --text: #fff;
      --danger: rgba(190,70,70,0.9);
      --ok: rgba(67,110,188,0.8);
    }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #111;
      font-family: Arial, sans-serif;
      touch-action: none;
      user-select: none;
    }

    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      touch-action: none;
    }

    .hud {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      color: var(--text);
      background: var(--panel);
      border: 1px solid var(--panelBorder);
      border-radius: 999px;
      padding: 10px 18px;
      font-size: 13px;
      letter-spacing: 0.04em;
      pointer-events: none;
      text-align: center;
      backdrop-filter: blur(4px);
      z-index: 40;
    }

    .panel {
      position: absolute;
      left: 18px;
      top: 18px;
      z-index: 30;
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px solid var(--panelBorder);
      border-radius: 12px;
      background: var(--panel);
      padding: 8px 12px;
      color: var(--text);
      backdrop-filter: blur(4px);
    }

    .panel label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.85);
    }

    .panel select {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      color: white;
      padding: 6px 10px;
      font-size: 13px;
      outline: none;
    }

    .mode-toggle,
    .eraser-toggle,
    .clear-all-button {
      position: absolute;
      right: 20px;
      z-index: 15;
      background: rgba(0,0,0,0.35);
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      cursor: pointer;
      user-select: none;
      pointer-events: auto;
    }

    .mode-toggle { top: 20px; }
    .mode-toggle.play { background: var(--ok); }

    .eraser-toggle { top: 72px; }
    .eraser-toggle.active { background: var(--danger); }

    .clear-all-button {
      top: 124px;
      background: rgba(188, 67, 67, 0.9);
    }

    @media (max-width: 768px) {
      .hud { font-size: 11px; padding: 8px 12px; }
      .panel { top: 10px; left: 10px; }
      .mode-toggle, .eraser-toggle, .clear-all-button { font-size: 12px; padding: 8px 10px; }
      .clear-all-button { top: 116px; }
    }
  </style>
</head>
<body>
  <div class="hud">Move: WASD / Arrow keys • Click to place • Eraser removes blocks</div>

  <div class="panel">
    <label for="placementMode">Place</label>
    <select id="placementMode">
      <option value="block">Block</option>
      <option value="spawn">Spawn</option>
      <option value="zombie">Zombie</option>
    </select>
  </div>

  <button id="modeToggle" class="mode-toggle">Play Mode: OFF</button>
  <button id="eraserToggle" class="eraser-toggle">Eraser: OFF</button>
  <button id="clearAllButton" class="clear-all-button">Clear All</button>

  <script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.module.js';

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x98ccff);
    scene.fog = new THREE.Fog(0x98ccff, 18, 120);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 500);
    camera.rotation.order = 'YXZ';

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    document.body.appendChild(renderer.domElement);

    const hemi = new THREE.HemisphereLight(0xdff6ff, 0x2e452d, 1.3);
    scene.add(hemi);

    const sun = new THREE.DirectionalLight(0xffffff, 1.1);
    sun.position.set(12, 18, 8);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    sun.shadow.camera.left = -60;
    sun.shadow.camera.right = 60;
    sun.shadow.camera.top = 60;
    sun.shadow.camera.bottom = -60;
    scene.add(sun);

    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(200, 200, 1, 1),
      new THREE.MeshStandardMaterial({ color: 0x6dbb5e, roughness: 0.95, metalness: 0.04 })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.receiveShadow = true;
    scene.add(floor);

    const blockSize = 1;
    const placedBlocks = [];
    let spawnPoint = null;
    let playMode = false;
    let eraserMode = false;

    const player = {
      pos: new THREE.Vector3(0, 1.6, 12),
      yaw: 0,
      pitch: 0,
      velocityY: 0,
      radius: 0.42,
      height: 1.7,
      speed: 7.5,
      onGround: true,
      health: 10,
      maxHealth: 10,
      standingOnBlockTop: null
    };

    const keys = { w: false, s: false, a: false, d: false };
    const arrowKeys = { left: false, right: false, up: false, down: false };

    const modeToggle = document.getElementById('modeToggle');
    const eraserToggle = document.getElementById('eraserToggle');
    const clearAllButton = document.getElementById('clearAllButton');
    const placementModeSelect = document.getElementById('placementMode');

    function updateModeButton() {
      modeToggle.textContent = playMode ? 'Play Mode: ON' : 'Play Mode: OFF';
      modeToggle.classList.toggle('play', playMode);
    }

    function updateEraserButton() {
      eraserToggle.textContent = eraserMode ? 'Eraser: ON' : 'Eraser: OFF';
      eraserToggle.classList.toggle('active', eraserMode);
    }

    function disposeMesh(obj) {
      if (!obj) return;
      if (obj.geometry) obj.geometry.dispose?.();
      if (obj.material) {
        if (Array.isArray(obj.material)) {
          obj.material.forEach((m) => m.dispose?.());
        } else {
          obj.material.dispose?.();
        }
      }
      if (obj.parent) obj.parent.remove(obj);
    }

    function clearAllPlacedBlocks() {
      for (const block of [...placedBlocks]) {
        disposeMesh(block);
      }
      placedBlocks.length = 0;

      if (spawnPoint) {
        scene.remove(spawnPoint);
        spawnPoint = null;
      }

      updateStatus('Everything erased');
    }

    function updateStatus(msg) {
      const hud = document.querySelector('.hud');
      hud.textContent = msg;
    }

    function makeBlock(color = 0x8ee26d) {
      const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(blockSize, blockSize, blockSize),
        new THREE.MeshStandardMaterial({ color, roughness: 0.9, metalness: 0.05 })
      );
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      mesh.userData.isBlock = true;
      return mesh;
    }

    function makeSpawnMesh() {
      const group = new THREE.Group();
      const base = new THREE.Mesh(
        new THREE.BoxGeometry(1.5, 0.35, 1.5),
        new THREE.MeshStandardMaterial({ color: 0xf3f3f4, roughness: 0.7 })
      );
      base.position.y = 0.18;
      group.add(base);

      const ring = new THREE.Mesh(
        new THREE.CylinderGeometry(0.32, 0.32, 0.12, 20),
        new THREE.MeshStandardMaterial({ color: 0xef4955, emissive: 0xef4955, emissiveIntensity: 0.5 })
      );
      ring.position.y = 0.42;
      group.add(ring);

      group.userData.isSpawn = true;
      return group;
    }

    function snapPoint(v) {
      return Math.round(v / blockSize) * blockSize;
    }

    function findGroundYAt(x, z) {
      let topY = 0;
      for (const block of placedBlocks) {
        const box = new THREE.Box3().setFromObject(block);
        const withinX = Math.abs(block.position.x - x) < blockSize * 0.8;
        const withinZ = Math.abs(block.position.z - z) < blockSize * 0.8;
        if (withinX && withinZ) {
          topY = Math.max(topY, box.max.y);
        }
      }
      return topY;
    }

    function placeAtHit(hit) {
      if (!hit || !hit.point) return;
      const pos = hit.point.clone();

      if (hit.object.userData.isFloor) {
        pos.y = 0.5;
      } else if (hit.object.userData.isBlock) {
        const box = new THREE.Box3().setFromObject(hit.object);
        pos.y = box.max.y + 0.5;
      }

      const mode = placementModeSelect.value;
      const snapped = new THREE.Vector3(
        snapPoint(pos.x),
        snapPoint(pos.y),
        snapPoint(pos.z)
      );

      if (mode === 'spawn') {
        if (spawnPoint) scene.remove(spawnPoint);
        const mesh = makeSpawnMesh();
        mesh.position.copy(snapped);
        mesh.position.y = snapped.y + 0.2;
        spawnPoint = mesh;
        scene.add(mesh);
        updateStatus('Spawn point placed');
        return;
      }

      if (mode === 'zombie') {
        const zombie = new THREE.Group();
        const body = new THREE.Mesh(
          new THREE.BoxGeometry(0.7, 1.2, 0.4),
          new THREE.MeshStandardMaterial({ color: 0x2a5c3c, roughness: 0.9 })
        );
        body.position.y = 0.6;
        zombie.add(body);

        const head = new THREE.Mesh(
          new THREE.BoxGeometry(0.5, 0.5, 0.5),
          new THREE.MeshStandardMaterial({ color: 0x6db981, roughness: 0.9 })
        );
        head.position.y = 1.4;
        zombie.add(head);

        zombie.position.copy(snapped);
        zombie.position.y += 0.15;
        zombie.userData.isZombie = true;
        scene.add(zombie);
        updateStatus('Zombie placed');
        return;
      }

      const block = makeBlock();
      block.position.copy(snapped);
      block.position.y += 0.5;
      scene.add(block);
      placedBlocks.push(block);
      updateStatus('Block placed');
    }

    function removeBlockAtHit(hit) {
      if (!hit || !hit.object || !hit.object.userData.isBlock) return;
      const index = placedBlocks.indexOf(hit.object);
      if (index >= 0) {
        placedBlocks.splice(index, 1);
      }
      disposeMesh(hit.object);
      updateStatus('Block removed');
    }

    modeToggle.addEventListener('click', () => {
      playMode = !playMode;
      updateModeButton();
      if (playMode) {
        if (spawnPoint) {
          player.pos.set(spawnPoint.position.x, spawnPoint.position.y + 1.2, spawnPoint.position.z);
        }
        updateStatus('Play Mode: ON');
      } else {
        updateStatus('Creative Mode');
      }
    });

    eraserToggle.addEventListener('click', () => {
      eraserMode = !eraserMode;
      updateEraserButton();
      updateStatus(eraserMode ? 'Eraser: ON' : 'Eraser: OFF');
    });

    clearAllButton.addEventListener('click', () => {
      clearAllPlacedBlocks();
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Delete' || event.key === 'Backspace') {
        clearAllPlacedBlocks();
      }

      if (event.key.toLowerCase() === 'e') {
        eraserMode = !eraserMode;
        updateEraserButton();
      }

      const k = event.key.toLowerCase();
      if (k === 'w') keys.w = true;
      if (k === 's') keys.s = true;
      if (k === 'a') keys.a = true;
      if (k === 'd') keys.d = true;

      if (event.key === 'ArrowLeft') arrowKeys.left = true;
      if (event.key === 'ArrowRight') arrowKeys.right = true;
      if (event.key === 'ArrowUp') arrowKeys.up = true;
      if (event.key === 'ArrowDown') arrowKeys.down = true;
    });

    window.addEventListener('keyup', (event) => {
      const k = event.key.toLowerCase();
      if (k === 'w') keys.w = false;
      if (k === 's') keys.s = false;
      if (k === 'a') keys.a = false;
      if (k === 'd') keys.d = false;

      if (event.key === 'ArrowLeft') arrowKeys.left = false;
      if (event.key === 'ArrowRight') arrowKeys.right = false;
      if (event.key === 'ArrowUp') arrowKeys.up = false;
      if (event.key === 'ArrowDown') arrowKeys.down = false;
    });

    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();

    function pointerToNDC(clientX, clientY) {
      const rect = renderer.domElement.getBoundingClientRect();
      pointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;
    }

    function handleClick(clientX, clientY) {
      pointerToNDC(clientX, clientY);
      raycaster.setFromCamera(pointer, camera);

      const hitTargets = [floor, ...placedBlocks];
      const hits = raycaster.intersectObjects(hitTargets, false);
      if (hits.length === 0) {
        const point = new THREE.Vector3();
        const dir = new THREE.Vector3();
        raycaster.ray.direction.copy(camera.getWorldDirection(dir));
        const distance = 30;
        point.copy(camera.position).add(raycaster.ray.direction.multiplyScalar(distance));
        const grounded = new THREE.Vector3(
          Math.round(point.x / blockSize) * blockSize,
          0.5,
          Math.round(point.z / blockSize) * blockSize
        );

        const block = makeBlock();
        block.position.copy(grounded);
        scene.add(block);
        placedBlocks.push(block);
        updateStatus('Block placed');
        return;
      }

      const hit = hits[0];
      if (eraserMode) {
        removeBlockAtHit(hit);
      } else {
        placeAtHit(hit);
      }
    }

    renderer.domElement.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      handleClick(event.clientX, event.clientY);
    });

    function updateCamera() {
      camera.position.set(player.pos.x, player.pos.y + 1.25, player.pos.z);
      camera.rotation.y = player.yaw;
      camera.rotation.x = player.pitch;
    }

    function updatePlayer(dt) {
      if (!playMode) return;

      if (arrowKeys.left) player.yaw += 2.2 * dt;
      if (arrowKeys.right) player.yaw -= 2.2 * dt;
      if (arrowKeys.up) player.pitch = Math.max(-1.45, Math.min(1.45, player.pitch - 1.6 * dt));
      if (arrowKeys.down) player.pitch = Math.max(-1.45, Math.min(1.45, player.pitch + 1.6 * dt));

      let moveX = 0;
      let moveZ = 0;
      if (keys.w) moveZ -= 1;
      if (keys.s) moveZ += 1;
      if (keys.a) moveX -= 1;
      if (keys.d) moveX += 1;

      const move = new THREE.Vector3();
      move.x = Math.sin(player.yaw) * moveZ + Math.cos(player.yaw) * moveX;
      move.z = Math.cos(player.yaw) * moveZ - Math.sin(player.yaw) * moveX;

      if (move.lengthSq() > 0) {
        move.normalize().multiplyScalar(player.speed * dt);
        player.pos.x += move.x;
        player.pos.z += move.z;
      }

      player.pos.y += player.velocityY * dt;
      player.velocityY -= 18 * dt;

      const groundTop = findGroundYAt(player.pos.x, player.pos.z);
      if (player.pos.y <= groundTop + 1.5) {
        player.pos.y = groundTop + 1.5;
        player.velocityY = 0;
        player.onGround = true;
      }

      updateCamera();
    }

    window.addEventListener('keydown', (event) => {
      if (event.code === 'Space') {
        if (player.onGround) {
          player.velocityY = 7.5;
          player.onGround = false;
        }
      }
    });

    updateModeButton();
    updateEraserButton();
    updateCamera();

    function animate() {
      requestAnimationFrame(animate);
      const dt = Math.min(0.033, renderer.info.render.frame / 60 || 0.016);
      updatePlayer(dt);
      renderer.render(scene, camera);
    }

    animate();
  </script>
</body>
</html>
