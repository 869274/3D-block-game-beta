<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>3D Block Game Beta</title>
  <style>
    :root {
      --panel-bg: rgba(0, 0, 0, 0.28);
      --panel-border: rgba(255,255,255,0.18);
      --red: rgba(188, 67, 67, 0.9);
      --blue: rgba(67, 110, 188, 0.8);
      --text: white;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #111;
      font-family: Arial, sans-serif;
      touch-action: none;
      user-select: none;
    }

    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      touch-action: none;
    }

    .hud {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      color: white;
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 999px;
      padding: 10px 18px;
      font-size: 13px;
      letter-spacing: 0.04em;
      pointer-events: none;
      text-align: center;
      backdrop-filter: blur(4px);
      z-index: 40;
    }

    .status-hud {
      position: absolute;
      top: 58px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0,0,0,0.3);
      color: white;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      pointer-events: none;
      z-index: 35;
      white-space: nowrap;
    }

    .placement-panel {
      position: absolute;
      top: 18px;
      left: 18px;
      z-index: 30;
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--panel-bg);
      border: 1px solid var(--panel-border);
      border-radius: 12px;
      padding: 8px 12px;
      color: white;
      backdrop-filter: blur(4px);
      pointer-events: auto;
    }

    .placement-panel label {
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
    }

    .placement-panel select {
      background: rgba(255,255,255,0.10);
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 13px;
      outline: none;
    }

    .mode-toggle,
    .eraser-toggle,
    .clear-all-button {
      position: absolute;
      right: 20px;
      z-index: 15;
      background: rgba(0,0,0,0.35);
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      cursor: pointer;
      user-select: none;
      pointer-events: auto;
    }

    .mode-toggle { top: 20px; }
    .mode-toggle.play { background: var(--blue); border-color: rgba(255,255,255,0.35); }

    .eraser-toggle { top: 70px; }
    .eraser-toggle.active { background: var(--red); border-color: rgba(255,255,255,0.35); }

    .clear-all-button {
      top: 120px;
      background: rgba(190, 70, 70, 0.88);
      border-color: rgba(255,255,255,0.35);
    }

    .player-hp-panel {
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 12px;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 12px;
      z-index: 25;
      pointer-events: none;
      color: white;
      backdrop-filter: blur(4px);
    }

    .player-hp-label {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.88);
      font-weight: bold;
    }

    .player-hp-bar {
      width: 120px;
      height: 12px;
      border-radius: 999px;
      background: rgba(90, 0, 0, 0.8);
      border: 1px solid rgba(255,255,255,0.2);
      overflow: hidden;
      position: relative;
    }

    .player-hp-fill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 100%;
      background: linear-gradient(to right, #ff5c5c, #ff2c2c);
      border-radius: 999px;
    }

    .inventory-bar {
      position: fixed;
      left: 50%;
      bottom: 22px;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 18px;
      background: rgba(0, 0, 0, 0.28);
      border: 1px solid rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(4px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.2);
      z-index: 20;
      pointer-events: auto;
    }

    .slot {
      width: 76px;
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
    }

    .slot.selected {
      border-color: #63c8ff;
      box-shadow: inset 0 0 0 2px rgba(99, 200, 255, 0.7), 0 0 0 2px rgba(99, 200, 255, 0.35);
      background: rgba(255,255,255,0.10);
    }

    .slot-label {
      position: absolute;
      bottom: 6px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.9);
      font-weight: bold;
      text-transform: uppercase;
    }

    .sword-icon {
      position: relative;
      width: 42px;
      height: 42px;
      transform: rotate(35deg);
      filter: drop-shadow(0 3px 4px rgba(0,0,0,0.35));
    }

    .sword-icon .blade {
      position: absolute;
      left: 50%;
      top: 4px;
      transform: translateX(-50%);
      width: 4px;
      height: 22px;
      background: linear-gradient(to bottom, #f2f6ff, #dfe8ff 55%, #9ca9c4);
      border-radius: 2px;
      box-shadow: inset 0 0 2px rgba(255,255,255,0.8);
    }

    .sword-icon .guard {
      position: absolute;
      left: 50%;
      top: 22px;
      transform: translateX(-50%);
      width: 26px;
      height: 8px;
      background: linear-gradient(to right, #d4c8a0, #f4e6b2, #d4c8a0);
      border-radius: 3px;
    }

    .sword-icon .handle {
      position: absolute;
      left: 50%;
      top: 28px;
      transform: translateX(-50%);
      width: 6px;
      height: 16px;
      background: linear-gradient(to bottom, #6b3d23, #2a1a13);
      border-radius: 3px;
    }

    .sword-icon .pommel {
      position: absolute;
      left: 50%;
      top: 42px;
      transform: translateX(-50%);
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #f7e7b5, #d9b85c 62%, #b3882d);
    }

    @media (max-width: 768px) {
      .hud { font-size: 11px; padding: 8px 12px; }
      .placement-panel { top: 10px; left: 10px; }
      .mode-toggle, .eraser-toggle, .clear-all-button { font-size: 12px; padding: 8px 10px; }
      .clear-all-button { top: 112px; }
      .inventory-bar { bottom: 16px; }
      .slot { width: 64px; height: 64px; }
    }
  </style>
</head>
<body>
  <div class="hud">Move: WASD / Arrow keys • Click to place • Eraser removes blocks</div>
  <div id="statusHud" class="status-hud">Creative</div>

  <div class="player-hp-panel">
    <div class="player-hp-label">HP</div>
    <div class="player-hp-bar">
      <div class="player-hp-fill"></div>
    </div>
  </div>

  <div class="placement-panel">
    <label for="placementMode">Place</label>
    <select id="placementMode">
      <option value="block">Block</option>
      <option value="spawn">Spawn</option>
      <option value="zombie">Zombie</option>
    </select>
  </div>

  <button id="modeToggle" class="mode-toggle">Play Mode: OFF</button>
  <button id="eraserToggle" class="eraser-toggle">Eraser: OFF</button>
  <button id="clearAllButton" class="clear-all-button">Clear All</button>

  <div id="inventoryBar" class="inventory-bar">
    <div id="swordSlot" class="slot selected">
      <div class="sword-icon">
        <span class="blade"></span>
        <span class="guard"></span>
        <span class="handle"></span>
        <span class="pommel"></span>
      </div>
      <span class="slot-label">Sword</span>
    </div>
  </div>

  <script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.module.js';

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x98ccff);
    scene.fog = new THREE.Fog(0x98ccff, 18, 120);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 500);
    camera.rotation.order = 'YXZ';

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    document.body.appendChild(renderer.domElement);

    const hemi = new THREE.HemisphereLight(0xdff6ff, 0x2e452d, 1.3);
    scene.add(hemi);

    const sun = new THREE.DirectionalLight(0xffffff, 1.1);
    sun.position.set(12, 18, 8);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    sun.shadow.camera.left = -60;
    sun.shadow.camera.right = 60;
    sun.shadow.camera.top = 60;
    sun.shadow.camera.bottom = -60;
    scene.add(sun);

    const floor = new THREE.Mesh(
      new THREE.PlaneGeometry(200, 200, 1, 1),
      new THREE.MeshStandardMaterial({ color: 0x6dbb5e, roughness: 0.95, metalness: 0.04 })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.receiveShadow = true;
    floor.userData.isFloor = true;
    scene.add(floor);

    const blockSize = 1;
    const placedBlocks = [];
    const zombies = [];
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    let spawnPoint = null;
    let playMode = false;
    let eraserMode = false;

    const player = {
      pos: new THREE.Vector3(0, 1.5, 12),
      yaw: 0,
      pitch: 0,
      velocityY: 0,
      radius: 0.42,
      height: 1.7,
      speed: 7.5,
      onGround: true,
      health: 10,
      maxHealth: 10,
      hitFlash: 0
    };

    const keys = { w: false, s: false, a: false, d: false };
    const arrowKeys = { left: false, right: false, up: false, down: false };

    const modeToggle = document.getElementById('modeToggle');
    const eraserToggle = document.getElementById('eraserToggle');
    const clearAllButton = document.getElementById('clearAllButton');
    const placementModeSelect = document.getElementById('placementMode');
    const statusHud = document.getElementById('statusHud');
    const playerHpFill = document.querySelector('.player-hp-fill');
    const swordSlot = document.getElementById('swordSlot');

    function setStatus(msg) {
      statusHud.textContent = msg;
    }

    function updatePlayerHealthUI() {
      const ratio = Math.max(0, player.health / player.maxHealth);
      playerHpFill.style.width = `${ratio * 100}%`;
    }

    function updateModeButton() {
      modeToggle.textContent = playMode ? 'Play Mode: ON' : 'Play Mode: OFF';
      modeToggle.classList.toggle('play', playMode);
    }

    function updateEraserButton() {
      eraserToggle.textContent = eraserMode ? 'Eraser: ON' : 'Eraser: OFF';
      eraserToggle.classList.toggle('active', eraserMode);
    }

    function makeBlock(color = 0x8ee26d) {
      const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(blockSize, blockSize, blockSize),
        new THREE.MeshStandardMaterial({ color, roughness: 0.9, metalness: 0.05 })
      );
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      mesh.userData.isBlock = true;
      return mesh;
    }

    function makeSpawnMarker() {
      const group = new THREE.Group();
      const base = new THREE.Mesh(
        new THREE.BoxGeometry(1.5, 0.25, 1.5),
        new THREE.MeshStandardMaterial({ color: 0xf3f3f4, roughness: 0.7 })
      );
      base.position.y = 0.12;
      group.add(base);

      const ring = new THREE.Mesh(
        new THREE.CylinderGeometry(0.36, 0.36, 0.12, 24),
        new THREE.MeshStandardMaterial({ color: 0xef4955, emissive: 0xef4955, emissiveIntensity: 0.6 })
      );
      ring.position.y = 0.35;
      group.add(ring);

      group.userData.isSpawn = true;
      return group;
    }

    function makeZombie() {
      const group = new THREE.Group();
      const body = new THREE.Mesh(
        new THREE.BoxGeometry(0.7, 1.2, 0.4),
        new THREE.MeshStandardMaterial({ color: 0x2d6745, roughness: 0.9 })
      );
      body.position.y = 0.6;
      group.add(body);

      const head = new THREE.Mesh(
        new THREE.BoxGeometry(0.5, 0.5, 0.5),
        new THREE.MeshStandardMaterial({ color: 0x75c98b, roughness: 0.9 })
      );
      head.position.y = 1.45;
      group.add(head);

      group.userData.isZombie = true;
      return group;
    }

    function snapCoord(v) {
      return Math.round(v / blockSize) * blockSize;
    }

    function findGroundYAt(x, z) {
      let topY = 0;
      for (const block of placedBlocks) {
        const box = new THREE.Box3().setFromObject(block);
        const withinX = Math.abs(block.position.x - x) < blockSize * 0.8;
        const withinZ = Math.abs(block.position.z - z) < blockSize * 0.8;
        if (withinX && withinZ) {
          topY = Math.max(topY, box.max.y);
        }
      }
      return topY;
    }

    function disposeMesh(obj) {
      if (!obj) return;
      if (obj.geometry) obj.geometry.dispose?.();
      if (obj.material) {
        if (Array.isArray(obj.material)) {
          obj.material.forEach((m) => m.dispose?.());
        } else {
          obj.material.dispose?.();
        }
      }
      if (obj.parent) obj.parent.remove(obj);
    }

    function clearAllPlacedBlocks() {
      for (const block of [...placedBlocks]) {
        disposeMesh(block);
      }
      placedBlocks.length = 0;

      for (const zombie of [...zombies]) {
        disposeMesh(zombie);
      }
      zombies.length = 0;

      if (spawnPoint) {
        disposeMesh(spawnPoint);
        spawnPoint = null;
      }

      updatePlayerHealthUI();
      setStatus('Everything erased');
    }

    function removeBlockFromWorld(hit) {
      if (!hit || !hit.object || !hit.object.userData.isBlock) return;
      const index = placedBlocks.indexOf(hit.object);
      if (index >= 0) placedBlocks.splice(index, 1);
      disposeMesh(hit.object);
      setStatus('Block removed');
    }

    function handlePlacement(hit) {
      if (!hit || !hit.point) return;
      const pos = hit.point.clone();

      const mode = placementModeSelect.value;
      const snapped = new THREE.Vector3(
        snapCoord(pos.x),
        snapCoord(pos.y + 0.5),
        snapCoord(pos.z)
      );

      if (mode === 'spawn') {
        if (spawnPoint) disposeMesh(spawnPoint);
        const marker = makeSpawnMarker();
        marker.position.copy(snapped);
        marker.position.y = snapped.y + 0.2;
        spawnPoint = marker;
        scene.add(marker);
        setStatus('Spawn point set');
        return;
      }

      if (mode === 'zombie') {
        const zombie = makeZombie();
        zombie.position.copy(snapped);
        zombie.position.y = Math.max(0.1, snapped.y + 0.1);
        scene.add(zombie);
        zombies.push(zombie);
        setStatus('Zombie placed');
        return;
      }

      const block = makeBlock();
      block.position.copy(snapped);
      block.position.y += 0.5;
      scene.add(block);
      placedBlocks.push(block);
      setStatus('Block placed');
    }

    function handleClick(clientX, clientY) {
      pointer.x = ((clientX / window.innerWidth) * 2) - 1;
      pointer.y = -((clientY / window.innerHeight) * 2) + 1;

      raycaster.setFromCamera(pointer, camera);
      const useTargets = [floor, ...placedBlocks];
      const hits = raycaster.intersectObjects(useTargets, false);

      if (hits.length === 0) {
        const worldPos = new THREE.Vector3();
        const dir = new THREE.Vector3();
        camera.getWorldDirection(dir);
        worldPos.copy(camera.position).add(dir.multiplyScalar(10));

        const block = makeBlock();
        block.position.set(snapCoord(worldPos.x), 0.5, snapCoord(worldPos.z));
        scene.add(block);
        placedBlocks.push(block);
        setStatus('Block placed');
        return;
      }

      const hit = hits[0];
      if (eraserMode) {
        removeBlockFromWorld(hit);
      } else {
        handlePlacement(hit);
      }
    }

    renderer.domElement.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      handleClick(event.clientX, event.clientY);
    });

    modeToggle.addEventListener('click', () => {
      playMode = !playMode;
      updateModeButton();
      if (playMode) {
        if (spawnPoint) {
          player.pos.set(spawnPoint.position.x, spawnPoint.position.y + 1.2, spawnPoint.position.z);
        }
        setStatus('Play Mode: ON');
      } else {
        setStatus('Creative Mode');
      }
    });

    eraserToggle.addEventListener('click', () => {
      eraserMode = !eraserMode;
      updateEraserButton();
      setStatus(eraserMode ? 'Eraser: ON' : 'Eraser: OFF');
    });

    clearAllButton.addEventListener('click', () => {
      clearAllPlacedBlocks();
    });

    swordSlot.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      swordSlot.classList.add('selected');
    });

    function updateCamera() {
      camera.position.set(player.pos.x, player.pos.y + 1.3, player.pos.z);
      camera.rotation.y = player.yaw;
      camera.rotation.x = player.pitch;
    }

    function updatePlayer(dt) {
      if (!playMode) return;

      if (arrowKeys.left) player.yaw += 2.2 * dt;
      if (arrowKeys.right) player.yaw -= 2.2 * dt;
      if (arrowKeys.up) player.pitch = Math.max(-1.45, Math.min(1.45, player.pitch - 1.6 * dt));
      if (arrowKeys.down) player.pitch = Math.max(-1.45, Math.min(1.45, player.pitch + 1.6 * dt));

      let moveX = 0;
      let moveZ = 0;
      if (keys.w) moveZ -= 1;
      if (keys.s) moveZ += 1;
      if (keys.a) moveX -= 1;
      if (keys.d) moveX += 1;

      const move = new THREE.Vector3();
      move.x = Math.sin(player.yaw) * moveZ + Math.cos(player.yaw) * moveX;
      move.z = Math.cos(player.yaw) * moveZ - Math.sin(player.yaw) * moveX;

      if (move.lengthSq() > 0) {
        move.normalize().multiplyScalar(player.speed * dt);
        player.pos.x += move.x;
        player.pos.z += move.z;
      }

      player.pos.y += player.velocityY * dt;
      player.velocityY -= 18 * dt;

      const groundTop = findGroundYAt(player.pos.x, player.pos.z);
      if (player.pos.y <= groundTop + 1.5) {
        player.pos.y = groundTop + 1.5;
        player.velocityY = 0;
        player.onGround = true;
      }

      updateCamera();
    }

    window.addEventListener('keydown', (event) => {
      const k = event.key.toLowerCase();
      if (k === 'w') keys.w = true;
      if (k === 's') keys.s = true;
      if (k === 'a') keys.a = true;
      if (k === 'd') keys.d = true;

      if (event.key === 'ArrowLeft') arrowKeys.left = true;
      if (event.key === 'ArrowRight') arrowKeys.right = true;
      if (event.key === 'ArrowUp') arrowKeys.up = true;
      if (event.key === 'ArrowDown') arrowKeys.down = true;

      if (event.key === 'Delete' || event.key === 'Backspace') clearAllPlacedBlocks();
      if (k === 'e') {
        eraserMode = !eraserMode;
        updateEraserButton();
        setStatus(eraserMode ? 'Eraser: ON' : 'Eraser: OFF');
      }
      if (event.code === 'Space' && player.onGround) {
        player.velocityY = 7.5;
        player.onGround = false;
      }
    });

    window.addEventListener('keyup', (event) => {
      const k = event.key.toLowerCase();
      if (k === 'w') keys.w = false;
      if (k === 's') keys.s = false;
      if (k === 'a') keys.a = false;
      if (k === 'd') keys.d = false;
      if (event.key === 'ArrowLeft') arrowKeys.left = false;
      if (event.key === 'ArrowRight') arrowKeys.right = false;
      if (event.key === 'ArrowUp') arrowKeys.up = false;
      if (event.key === 'ArrowDown') arrowKeys.down = false;
    });

    updateModeButton();
    updateEraserButton();
    updatePlayerHealthUI();
    updateCamera();

    function animate() {
      requestAnimationFrame(animate);
      const dt = 1 / 60;
      updatePlayer(dt);
      renderer.render(scene, camera);
    }

    animate();
  </script>
</body>
</html>
